{
  "name": "terrain-insight",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "check:devig": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs scripts/devig-reference-check.ts",
    "check:market": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs scripts/market-odds-check.ts",
    "check:market:integration": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs scripts/market-integration-check.ts",
    "check:market:fetch": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs scripts/market-fetch-check.ts",
    "check:model": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs scripts/model-check.ts",
    "check:backtest": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs scripts/backtest-check.ts",
    "smoke": "node scripts/smoke-production.mjs",
    "check": "npm run check:devig && npm run check:market && npm run check:market:integration && npm run check:market:fetch && npm run check:model && npm run check:backtest && npm run check:step3 && npm run check:tags",
    "import:football-data": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs scripts/import-football-data.ts",
    "check:backtest:strict": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs scripts/backtest-strict.ts",
    "check:ablation": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs scripts/module-ablation.ts",
    "check:markets": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs scripts/validate-markets.ts",
    "check:step3": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs scripts/step3-check.ts",
    "check:tags": "node --experimental-strip-types --import ./scripts/register-ts-hook.mjs scripts/check-tags.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
